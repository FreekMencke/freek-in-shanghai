---
layout: layouts/base.njk
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "{{ '/' | localUrl(lang) }}"
hero: true
bodyClass: home
---
<main>
  <div class="posts-grid" data-masonry>
    {%- for post in collections.posts | reverse %}
    {% include "partials/card.njk" %}
    {%- endfor %}
  </div>
</main>
