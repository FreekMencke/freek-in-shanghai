{#- `post` is the Dutch original (date, image); `entry` is the page in the current language (url, title, excerpt). -#}
{%- set img = post.data.image -%}
{%- set entry = post | translation(lang, collections.postsEn) -%}
<article class="card">
  <header>
    <h2 class="card-title"><a href="{{ entry.url }}">{{ entry.data.title }}</a></h2>
    <p class="entry-meta">
      <svg class="icon" aria-hidden="true"><use href="#icon-calendar"></use></svg>
      <a href="{{ entry.url }}"><time datetime="{{ post.date | isoDate }}">{{ post.date | date(lang) }}</time></a>
    </p>
  </header>
  <a class="card-image" href="{{ entry.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ img.card.src }}" srcset="{{ img.small.src }} {{ img.small.width }}w, {{ img.card.src }} {{ img.card.width }}w" sizes="(max-width: 767px) 100vw, 290px" width="{{ img.card.width }}" height="{{ img.card.height }}" alt="" loading="lazy" decoding="async">
  </a>
  <p class="card-excerpt">{{ entry.data.excerpt }}</p>
  <a class="card-more" href="{{ entry.url }}">{{ t.readMore }}<span class="visually-hidden">: {{ entry.data.title }}</span></a>
</article>
