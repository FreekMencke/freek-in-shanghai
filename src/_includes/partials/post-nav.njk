{%- set older = collections.posts | getPreviousCollectionItem(page) -%}
{%- set newer = collections.posts | getNextCollectionItem(page) -%}
<nav class="post-nav" aria-label="{{ site.text.postNavigation }}">
  {%- if older %}
  <a class="post-nav-older" href="{{ older.url }}" rel="prev">
    <span class="post-nav-label">{{ site.text.previousPost }}<span class="visually-hidden">:</span></span>{{ older.data.title }}
  </a>
  {%- endif %}
  {%- if newer %}
  <a class="post-nav-newer" href="{{ newer.url }}" rel="next">
    <span class="post-nav-label">{{ site.text.nextPost }}<span class="visually-hidden">:</span></span>{{ newer.data.title }}
  </a>
  {%- endif %}
</nav>
