{%- set older = collections.posts | getPreviousCollectionItem(original) -%}
{%- set newer = collections.posts | getNextCollectionItem(original) -%}
{%- set older = older and (older | translation(lang, collections.postsEn)) -%}
{%- set newer = newer and (newer | translation(lang, collections.postsEn)) -%}
<nav class="post-nav" aria-label="{{ t.postNavigation }}">
  {%- if older %}
  <a class="post-nav-older" href="{{ older.url }}" rel="prev">
    <span class="post-nav-label">{{ t.previousPost }}<span class="visually-hidden">:</span></span>{{ older.data.title }}
  </a>
  {%- endif %}
  {%- if newer %}
  <a class="post-nav-newer" href="{{ newer.url }}" rel="next">
    <span class="post-nav-label">{{ t.nextPost }}<span class="visually-hidden">:</span></span>{{ newer.data.title }}
  </a>
  {%- endif %}
</nav>
