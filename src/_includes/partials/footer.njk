<footer class="site-footer">
  <div class="container site-footer-inner">
    <nav aria-label="{{ t.socialMenu }}">
      <ul class="footer-menu">
        {%- for link in site.social %}
        <li><a href="{{ link.url }}" title="{{ t.onSocial(link.text) }}">{{ link.text }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <p class="footer-name">{{ site.author }}</p>
  </div>
</footer>
