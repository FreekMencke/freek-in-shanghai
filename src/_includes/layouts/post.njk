---
layout: layouts/base.njk
---
{#- The Dutch post supplies the date, tags, images and comments for both languages. -#}
{%- set original = page.fileSlug | original(collections.posts) -%}
{%- set image = original.data.image -%}
{%- set comments = original.data.comments -%}
<main class="content-area">
  <article class="entry">
    <header class="entry-header">
      <h1 class="entry-title">{{ title }}</h1>
      <p class="entry-meta">
        <svg class="icon" aria-hidden="true"><use href="#icon-calendar"></use></svg>
        <time datetime="{{ original.date | isoDate }}">{{ original.date | date(lang) }}</time>
      </p>
    </header>
    {%- if image.large %}
    <div class="entry-image">
      <img src="{{ image.large.src }}" width="{{ image.large.width }}" height="{{ image.large.height }}" alt="">
    </div>
    {%- endif %}
    <div class="entry-content">
      {{ content | safe }}
    </div>
    {%- if original.data.tags.length %}
    <footer class="entry-footer">
      <h2 class="visually-hidden">{{ t.tags }}</h2>
      <ul class="tag-links">
        {%- for slug in original.data.tags %}
        <li><a href="{{ ('/tag/' + slug + '/') | localUrl(lang) }}">{{ slug | tagName(lang) }}</a></li>
        {%- endfor %}
      </ul>
    </footer>
    {%- endif %}
  </article>
  {% include "partials/post-nav.njk" %}
  {% if comments.length %}{% include "partials/comments.njk" %}{% endif %}
</main>
