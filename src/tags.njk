---
layout: layouts/base.njk
pagination:
  data: tagList
  size: 1
  alias: tag
permalink: "/tag/{{ tag.slug }}/"
bodyClass: archive
eleventyComputed:
  title: "{{ tag.name }}"
---
<main>
  <header class="page-header">
    <h1 class="page-title">
      <svg class="icon" aria-hidden="true"><use href="#icon-tag"></use></svg>
      <span class="visually-hidden">{{ site.text.tagTitle }}: </span>{{ tag.name }}
    </h1>
  </header>
  <div class="posts-grid" data-masonry>
    {%- for post in collections[tag.slug] | reverse %}
    {% include "partials/card.njk" %}
    {%- endfor %}
  </div>
</main>
